<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 13 테마 아이콘용 모노크롬 레이어. minSdk 33이라 전 기기가 지원한다.

    시스템이 이 드로어블의 알파 채널만 읽어 사용자 테마 색으로 칠한다.
    그래서 색은 검정 하나로 두되 alpha 차이는 전경과 똑같이 유지한다 —
    붉은 점과 흐린 점의 위계가 단색으로 바뀌어도 남는다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 노선 -->
    <path
        android:fillColor="#000000"
        android:pathData="M40.5,26
                          A4.5,4.5 0 0 1 45,30.5
                          L45,77.5
                          A4.5,4.5 0 0 1 40.5,82
                          A4.5,4.5 0 0 1 36,77.5
                          L36,30.5
                          A4.5,4.5 0 0 1 40.5,26 Z" />

    <!-- 도착 임박 열차 (전경의 붉은 점과 같은 자리, 불투명) -->
    <path
        android:fillColor="#000000"
        android:pathData="M57,38
                          a9,9 0 1 0 18,0
                          a9,9 0 1 0 -18,0 Z" />

    <!-- 뒤따르는 열차 -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.45"
        android:pathData="M60.5,62
                          a5.5,5.5 0 1 0 11,0
                          a5.5,5.5 0 1 0 -11,0 Z" />
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.45"
        android:pathData="M60.5,79
                          a5.5,5.5 0 1 0 11,0
                          a5.5,5.5 0 1 0 -11,0 Z" />
</vector>
